# Stage 1: Build
FROM maven:3.9-eclipse-temurin-21-alpine AS build
WORKDIR /app
# 將所有子模組的 pom 優先複製以利於依賴緩存 / Copy all module poms for dependency caching
COPY backend/pom.xml backend/
COPY backend/module-common/pom.xml backend/module-common/
COPY backend/module-auth/pom.xml backend/module-auth/
COPY backend/module-organization/pom.xml backend/module-organization/
COPY backend/module-workflow/pom.xml backend/module-workflow/
COPY backend/module-notification/pom.xml backend/module-notification/
COPY backend/module-attendance/pom.xml backend/module-attendance/
COPY backend/module-leave/pom.xml backend/module-leave/
COPY backend/module-pos-core/pom.xml backend/module-pos-core/
COPY backend/module-pos-product/pom.xml backend/module-pos-product/
COPY backend/module-pos-inventory/pom.xml backend/module-pos-inventory/
COPY backend/module-pos-payment/pom.xml backend/module-pos-payment/
COPY backend/module-pos-tax/pom.xml backend/module-pos-tax/
COPY backend/module-pos-staff/pom.xml backend/module-pos-staff/
COPY backend/app/pom.xml backend/app/

# 複製主要代碼並編譯 / Copy source and build
COPY backend/ backend/
RUN mvn -f backend/pom.xml clean package -DskipTests

# Stage 2: Runtime
FROM eclipse-temurin:21-jre-alpine
WORKDIR /app
COPY --from=build /app/backend/app/target/*.jar app.jar
EXPOSE 8080
ENTRYPOINT ["java", "-jar", "app.jar"]
