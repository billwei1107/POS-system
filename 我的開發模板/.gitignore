# ============================================================
# 通用 .gitignore 模板
# 涵蓋常見技術棧：Node.js, Python, Java, Flutter, Docker
# ============================================================

# ========================================
# 系統檔案 / System Files
# ========================================
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# ========================================
# IDE 設定 / IDE Settings
# ========================================
.idea/
.vscode/
*.iml
*.ipr
*.iws
.project
.classpath
.settings/

# ========================================
# 環境變數 / Environment Variables
# ========================================
.env
.env.local
.env.*.local
env/local/*.env
env/server/*.env

# ========================================
# Node.js / JavaScript / TypeScript
# ========================================
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
.next/
.nuxt/
.cache/

# ========================================
# Python
# ========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
*.egg-info/
.eggs/

# ========================================
# Java / Spring Boot
# ========================================
target/
*.class
*.jar
*.war
*.ear
.gradle/
build/

# ========================================
# Flutter / Dart
# ========================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
build/
*.g.dart
*.freezed.dart

# ========================================
# Docker
# ========================================
docker/local/*.env
docker/server/*.env

# ========================================
# 建構產物 / Build Artifacts
# ========================================
*.log
logs/
apk/
*.apk
*.ipa
