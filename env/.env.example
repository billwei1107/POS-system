# POS 系統環境變數範本 / POS System Environment Variables Template
# 複製此檔案為 env/local/.env 並填入本地開發值

# ========================================
# 專案識別 / Project Identity
# ========================================
COMPOSE_PROJECT_NAME=pos

# ========================================
# 資料庫 / Database (PostgreSQL)
# ========================================
DB_HOST=postgres
DB_NAME=pos_db
DB_USER=pos_user
DB_PASSWORD=your_db_password_here
POSTGRES_PORT=5432

# ========================================
# 快取 / Cache (Redis)
# ========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password_here

# ========================================
# JWT 認證 / JWT Authentication
# ========================================
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=86400000

# ========================================
# 前端與 POS Demo 預設值 / Frontend and POS Demo Defaults
# ========================================
VITE_API_BASE_URL=http://localhost:38080
# Demo POS flow uses these IDs for browser verification and local handoff.
VITE_DEFAULT_STORE_ID=00000000-0000-0000-0000-000000000001
VITE_DEFAULT_TERMINAL_ID=00000000-0000-0000-0000-000000000101
VITE_DEFAULT_EMPLOYEE_ID=00000000-0000-0000-0000-000000000201
VITE_DEFAULT_TABLE_NO=A7
VITE_DEFAULT_GUEST_COUNT=2
